<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyShop - Profile</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f4f6fc;
            min-height: 100vh;
        }

        .site-header {
            background: #fff;
            border-bottom: 1px solid #e3e6f0;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 60px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .logo {
            font-size: 18px;
            font-weight: 700;
            color: #4e73df;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .nav-links a {
                font-size: 14px;
                text-decoration: none;
                padding: 6px 16px;
                border-radius: 6px;
                border: 1px solid transparent;
                transition: all 0.15s;
            }

        .btn-home {
            border-color: #d1d3e2;
            color: #555;
        }

            .btn-home:hover {
                background: #f0f2f8;
                color: #333;
            }

        .btn-logout {
            border-color: #d1d3e2;
            color: #e74a3b;
        }

            .btn-logout:hover {
                background: #fdf0ef;
            }

        .main-content {
            max-width: 520px;
            margin: 3rem auto;
            padding: 0 1.5rem;
        }

        .profile-card {
            background: #fff;
            border: 1px solid #e3e6f0;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            overflow: hidden;
        }

        .profile-banner {
            height: 80px;
            background: linear-gradient(135deg, #4e73df 0%, #36b9cc 100%);
        }

        .profile-avatar-wrap {
            display: flex;
            justify-content: center;
            margin-top: -36px;
            margin-bottom: 12px;
        }

        .profile-avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: #4e73df;
            border: 3px solid #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
            user-select: none;
        }

        .profile-info {
            text-align: center;
            padding: 0 2rem 1.5rem;
        }

        .profile-name {
            font-size: 18px;
            font-weight: 700;
            color: #333;
            margin-bottom: 4px;
        }

        .profile-username {
            font-size: 13px;
            color: #888;
            margin-bottom: 4px;
        }

        .profile-email {
            font-size: 13px;
            color: #888;
            margin-bottom: 1.25rem;
        }

        .btn-edit {
            display: inline-block;
            padding: 8px 22px;
            background: #4e73df;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: opacity 0.15s;
        }

            .btn-edit:hover {
                opacity: 0.88;
            }

        .card-divider {
            border: none;
            border-top: 1px solid #e3e6f0;
        }

        .edit-form {
            padding: 1.5rem 2rem 2rem;
            display: none;
        }

            .edit-form.open {
                display: block;
            }

            .edit-form h2 {
                font-size: 15px;
                font-weight: 600;
                color: #333;
                margin-bottom: 1.25rem;
            }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                display: block;
                font-size: 13px;
                font-weight: 500;
                color: #555;
                margin-bottom: 5px;
            }

            .form-group input {
                width: 100%;
                padding: 9px 13px;
                border: 1px solid #d1d3e2;
                border-radius: 6px;
                font-size: 14px;
                color: #333;
                background: #fafbff;
                outline: none;
                transition: border-color 0.15s;
            }

                .form-group input:focus {
                    border-color: #4e73df;
                    background: #fff;
                }

        .form-actions {
            display: flex;
            gap: 8px;
            margin-top: 1.25rem;
        }

        .btn-save {
            flex: 1;
            padding: 10px 0;
            background: #4e73df;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.15s;
        }

            .btn-save:hover {
                opacity: 0.88;
            }

        .btn-cancel {
            flex: 1;
            padding: 10px 0;
            background: #fff;
            color: #555;
            border: 1px solid #d1d3e2;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s;
        }

            .btn-cancel:hover {
                background: #f0f2f8;
            }
    </style>
</head>
<body>

    <header class="site-header">
        <a class="logo" href="index.html">MyShop</a>
        <nav class="nav-links">
            <a href="index.html" class="btn-home">Home</a>
            <a href="/logout" class="btn-logout">Logout</a>
        </nav>
    </header>

    <main class="main-content">
        <div class="profile-card">

            <div class="profile-banner"></div>

            <div class="profile-avatar-wrap">
                <div class="profile-avatar" id="avatarInitial">D</div>
            </div>

            <div class="profile-info">
                <p class="profile-name" id="displayName">Douglas McGee</p>
                <p class="profile-username" id="displayUsername">@douglas</p>
                <p class="profile-email" id="displayEmail">douglas@example.com</p>
                <button class="btn-edit" onclick="toggleEdit()">Edit Profile</button>
            </div>

            <hr class="card-divider">

            <div class="edit-form" id="editForm">
                <h2>Edit Profile</h2>
                <form action="/profile" method="POST">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="FullName" value="Douglas McGee" maxlength="100" required>
                    </div>
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="Username" value="douglas" maxlength="50" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="Email" value="douglas@example.com" required>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-save">Save Changes</button>
                        <button type="button" class="btn-cancel" onclick="toggleEdit()">Cancel</button>
                    </div>
                </form>
            </div>

        </div>
    </main>

    <script>
        function toggleEdit() {
          const form = document.getElementById('editForm');
          form.classList.toggle('open');
        }

        const nameEl = document.getElementById('displayName');
        const avatarEl = document.getElementById('avatarInitial');
        if (nameEl && avatarEl) {
          avatarEl.textContent = nameEl.textContent.trim().charAt(0).toUpperCase();
        }
    </script>

</body>
</html>