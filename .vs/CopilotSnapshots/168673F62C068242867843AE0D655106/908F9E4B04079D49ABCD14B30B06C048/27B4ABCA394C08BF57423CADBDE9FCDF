@using AuthAdminCrud.MVC.ViewModels
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@model ICollection<ProductVM>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyShop - Home</title>
    <link rel="stylesheet" href="~/css/home-index.css">
    <style>
        .btn-avatar {
            text-decoration: none;
            margin-left: 4px;
        }

        .avatar-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4e73df, #36b9cc);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(78, 115, 223, 0.4);
            transition: box-shadow 0.2s, transform 0.2s;
            user-select: none;
        }

        .avatar-circle:hover {
            box-shadow: 0 4px 12px rgba(78, 115, 223, 0.5);
            transform: scale(1.07);
        }

        .avatar-circle.guest {
            background: #d1d3e2;
            color: #888;
            box-shadow: none;
            font-size: 18px;
            font-weight: 400;
        }

        .avatar-circle.guest:hover {
            background: #bbbdd0;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <header class="site-header">
        <a class="logo" asp-controller="Home" asp-action="Index">MyShop</a>
        <nav class="nav-links">
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-controller="Account" asp-action="Profile" class="btn-avatar" title="@User.Identity.Name">
                    <div class="avatar-circle">@User.Identity.Name?.Substring(0, 1).ToUpper()</div>
                </a>
                <a asp-controller="Account" asp-action="Logout" class="btn-logout">Logout</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-outline">Login</a>
                <a asp-controller="Account" asp-action="Register" class="btn-primary">Register</a>
                <a asp-controller="Account" asp-action="Login" class="btn-avatar" title="Sign in">
                    <div class="avatar-circle guest">&#9998;</div>
                </a>
            }
        </nav>
    </header>
    <main class="main-content">
        <h1 class="section-title">Products</h1>
        <div class="products-grid">
            @foreach (var product in Model)
            {
                <!-- Product Card -->
                <div class="product-card">
                    <div class="product-img">
                        <img src="@product.ImageUrl" />
                    </div>
                    <div class="product-body">
                        <p class="product-name">@product.Name</p>
                        <p class="product-price">$@product.Price</p>
                        <button class="product-btn">@product.ButtonText</button>
                    </div>
                </div>
            }
        </div>
    </main>
    <footer class="footer">
        <span>Copyright &copy; 2025 MyShop. All rights reserved.</span>
    </footer>
</body>
</html>