@{
    Layout = null;
}
@model AuthAdminCrud.MVC.ViewModels.ProfileVM
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyShop - Profile</title>
    <link rel="stylesheet" href="~/css/account-profile.css">
</head>
<body>
    <header class="site-header">
        <a class="logo" asp-controller="Home" asp-action="Index">MyShop</a>
        <nav class="nav-links">
            <a asp-controller="Home" asp-action="Index" class="btn-home">Home</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="AdminPanel" asp-controller="DashBoard" asp-action="Index" class="btn-home">Admin Panel</a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">Logout</button>
            </form>
        </nav>
    </header>
    <main class="main-content">
        <div class="profile-card">
            <div class="profile-banner"></div>
            <div class="profile-avatar-wrap">
                <div class="profile-avatar" id="avatarInitial">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.FullName" />
                    }
                    else
                    {
                        @Model.FullName?.Substring(0, 1).ToUpper()
                    }
                </div>
            </div>
            <div class="profile-info">
                <p class="profile-name">@Model.FullName</p>
                <p class="profile-email">@Model.Email</p>
                <button class="btn-edit" onclick="toggleEdit()">Edit Profile</button>
            </div>
            <hr class="card-divider">
            <div class="edit-form" id="editForm">
                <h2>Edit Profile</h2>
                <form asp-action="Profile" asp-controller="Account" method="POST" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="FullName">Full Name</label>
                        <input asp-for="FullName" maxlength="100" required>
                        <span asp-validation-for="FullName"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" required>
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="File">Profile Image</label>
                        <input asp-for="File" type="file" accept="image/*">
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-save">Save Changes</button>
                        <button type="button" class="btn-cancel" onclick="toggleEdit()">Cancel</button>
                    </div>
                </form>
            </div>
            <hr class="card-divider">
            <div class="delete-section">
                <form asp-action="DeleteAccount" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-delete"
                            onclick="return confirm('Are you sure you want to delete your account? This cannot be undone.')">
                        Delete Account
                    </button>
                </form>
            </div>
        </div>
    </main>
    <script>
        function toggleEdit() {
            const form = document.getElementById('editForm');
            form.classList.toggle('open');
        }
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>