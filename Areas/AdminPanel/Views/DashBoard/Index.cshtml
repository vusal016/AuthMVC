@{
    ViewData["Title"] = "Products Management";
    Layout = null;   // ← Bu vacibdir! Layout-u bağlayırıq
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Products</title>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Bootstrap 4 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="~/css/adminpanel.css" asp-append-version="true" />
</head>
<body id="page-top">

    <div id="wrapper">

        <!-- ==================== SIDEBAR ==================== -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="#">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-store"></i>
                </div>
                <div class="sidebar-brand-text mx-3">Admin</div>
            </a>

            <hr class="sidebar-divider my-0">

            <li class="nav-item active">
                <a class="nav-link" href="/AdminPanel">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/Product">
                    <i class="fas fa-fw fa-box"></i>
                    <span>Products</span>
                </a>
            </li>

            <hr class="sidebar-divider d-none d-md-block">
        </ul>

        <!-- ==================== CONTENT ==================== -->
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>
                    <h4 class="mb-0 text-gray-800 ml-3">Products Management</h4>

                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">Admin</span>
                                <img class="img-profile rounded-circle" src="~/img/undraw_profile.svg" alt="">
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- Main Content -->
                <div class="container-fluid">
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Məhsullar</h1>
                        <button class="btn btn-primary shadow-sm" onclick="addNewProduct()">
                            <i class="fas fa-plus"></i> Yeni Məhsul
                        </button>
                    </div>

                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Bütün Məhsullar</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="productsTable">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Şəkil</th>
                                            <th>Ad</th>
                                            <th>Qiymət</th>
                                            <th>Stok</th>
                                            <th>Kateqoriya</th>
                                            <th>Əməliyyat</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="sticky-footer bg-white py-3">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>© 2026 Admin Panel</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let products = [
            { id: 1, name: "iPhone 15", price: 1899, stock: 45, category: "Telefon", img: "https://picsum.photos/id/20/60" },
            { id: 2, name: "Samsung Galaxy S24", price: 1599, stock: 32, category: "Telefon", img: "https://picsum.photos/id/60/60" }
        ];

        function renderTable() {
            const tbody = document.querySelector("#productsTable tbody");
            tbody.innerHTML = products.map(p => `
                <tr>
                    <td>${p.id}</td>
                    <td><img src="${p.img}" width="50" height="50" style="object-fit:cover; border-radius:6px;"></td>
                    <td>${p.name}</td>
                    <td>${p.price} AZN</td>
                    <td><span class="badge ${p.stock > 20 ? 'bg-success' : 'bg-warning'}">${p.stock}</span></td>
                    <td>${p.category}</td>
                    <td>
                        <button class="btn btn-sm btn-warning" onclick="editProduct(${p.id})">Düzəliş</button>
                        <button class="btn btn-sm btn-danger" onclick="deleteProduct(${p.id})">Sil</button>
                    </td>
                </tr>
            `).join('');
        }

        function addNewProduct() {
            const name = prompt("Məhsulun adı:");
            if (!name) return;
            const price = parseFloat(prompt("Qiymət (AZN):"));
            const stock = parseInt(prompt("Stok:"));
            const category = prompt("Kateqoriya:");

            products.push({
                id: products.length + 1,
                name, price, stock, category,
                img: "https://picsum.photos/id/" + (Math.floor(Math.random()*100)+1) + "/60"
            });
            renderTable();
        }

        function deleteProduct(id) {
            if (confirm("Bu məhsulu silmək istəyirsiniz?")) {
                products = products.filter(p => p.id !== id);
                renderTable();
            }
        }

        function editProduct(id) {
            alert("Edit funksiyası tezliklə əlavə olunacaq.");
        }

        window.onload = renderTable;
    </script>

</body>
</html>